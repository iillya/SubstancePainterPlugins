QT_ARCH = x86_64
QT_BUILDABI = x86_64-little_endian-lp64
QT_LIBCPP_ABI_TAG = 
QT.global.enabled_features = shared debug_and_release c++11 c++14 c++17 c++1z c99 c11 signaling_nan thread future concurrent dbus opensslv30 shared shared debug_and_release c++11 c++14 c++17 c++1z openssl
QT.global.disabled_features = static cross_compile pkg-config separate_debug_info appstore-compliant simulator_and_device rpath force_asserts framework c++20 c++2a c++2b c++2b reduce_relocations wasm-simd128 wasm-exceptions zstd openssl-linked opensslv11
QT.global.disabled_features += release build_all
QT_CONFIG += shared no-pkg-config debug_and_release c++11 c++14 c++17 c++1z openssl release debug
CONFIG +=  shared plugin_manifest
QT_VERSION = 6.5.3
QT_MAJOR_VERSION = 6
QT_MINOR_VERSION = 5
QT_PATCH_VERSION = 3

QT_MSVC_MAJOR_VERSION = 19
QT_MSVC_MINOR_VERSION = 29
QT_MSVC_PATCH_VERSION = 30151
QT_EDITION = Enterprise
QT_LICHECK = licheck.exe
QT_RELEASE_DATE = 2023-09-25
